			xlnx,num-mm2s-channels = <1>;
			xlnx,enable-multi-channel = <0>;
			status = "okay";
			xlnx,include-mm2s-sf = <1>;
			clock-names = "s_axi_lite_aclk" , "m_axi_sg_aclk" , "m_axi_s2mm_aclk";
			interrupt-names = "s2mm_introut";
			xlnx,include-mm2s = <0>;
